ENVIRONMENT=development
BASE_URL_DEVELOPMENT=http://localhost:8000
BASE_URL_PRODUCTION=https://api.chili-detection.com
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/database_name
API_KEY=your_secret_api_key_here
MAX_FILE_SIZE=10485760
UPLOAD_DIR=static/uploads
RESULT_DIR=static/result
MODEL_DIR=models
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
APP_VERSION=1.0.0
CORS_ORIGINS=*
CLASSIFICATION_POLLING_HOURS=16
CLASSIFICATION_POLLING_MINUTES=25
HUMIDITY_POLLING_INTERVAL_MS=3000
TIMEZONE=Asia/Jakarta
